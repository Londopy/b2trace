# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# gofmt indents with tabs
[{*.go,go.mod}]
indent_style = tab

[*.{json,jsonl,yml,yaml}]
indent_size = 2

[*.md]
# Markdown uses trailing double-space for hard line breaks.
trim_trailing_whitespace = false

# Winlink messages measured byte for byte: CRLF, latin-1 bodies, exact sizes
[corpus/*.b2f]
charset = unset
end_of_line = crlf
insert_final_newline = false
trim_trailing_whitespace = false
